# MCP is disabled by default. Set a strong random token before enabling it.
VRP_MCP_ENABLED=false
VRP_MCP_AUTH_TOKEN=
VRP_MCP_ALLOWED_ORIGINS=http://localhost:3000

AMAP_ENABLED=true
AMAP_APP_KEY=

# Select one provider for a running Engine pod.
MAP_PROVIDER=AMAP
HERE_API_KEY=
HERE_QPS=10
HERE_QUOTA=10000
HERE_INTERVAL=86400
HERE_WAIT_TIMEOUT=10
HERE_MATRIX_ROUTING_ENABLED=false
